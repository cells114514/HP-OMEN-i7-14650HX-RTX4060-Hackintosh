+IOReturn AirportItlwm::stopEnterpriseOutput()
+{
+    return _fCommandGate ? _fCommandGate->runAction(startEnterpriseOutputGated, nullptr) : kIOReturnNotReady;
+}
+
+IOReturn AirportItlwm::startEnterpriseOutputGated(OSObject *owner, void *startRequest, void *, void *, void *)
+{
+    auto that = OSDynamicCast(AirportItlwm, owner);
+    if (!that || !that->bsdInterface || !that->fHalService)
+        return kIOReturnNotReady;
+    if (!startRequest) {
+        IOReturn result = that->bsdInterface->stopOutputThread();
+        that->bsdInterface->flushOutputQueue();
+        IOLog("itlwm: OMEN_EAPSTATE preauth_output_stop result=0x%x\n", result);
+        return result;
+    }
+    auto ic = that->fHalService->get80211Controller();
+    if (!ic || !ic->ic_wcl_enterprise || ic->ic_state != IEEE80211_S_RUN ||
+        !ic->ic_bss || !ic->ic_if.if_snd.queue)
+        return kIOReturnNotReady;
+    // Starting the BSD pull worker does not authorize the 802.1X port.
+    // enqueuePacket and the existing RSN encapsulation both reject ordinary
+    // data while the peer port remains invalid.
+    IOReturn result = that->bsdInterface->startOutputThread();
+    IOLog("itlwm: OMEN_EAPSTATE preauth_output_start result=0x%x state=%d port_valid=%u\n",
+          result, int(ic->ic_state), unsigned(ic->ic_bss->ni_port_valid));
+    return result;
+}
+#endif
