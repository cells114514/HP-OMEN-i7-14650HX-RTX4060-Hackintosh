+
+// Sequoia WCLNetManager requires a 40-byte supplicant event. The success
+// status at byte 8 and transition-disable flags at byte 12 are zero. Leave
+// unneeded/reserved fields zero; no identity, PMK, PTK, or GTK is included.
+struct SequoiaSupplicantSuccessEvent {
+    uint32_t reserved0;
+    int32_t driverStatus;
+    uint32_t status;
+    uint32_t transitionDisableFlags;
+    uint8_t reserved16[20];
+    uint8_t duringJoin; // WCL fills this at byte 36.
+    uint8_t reserved37[3];
+};
+static_assert(sizeof(SequoiaSupplicantSuccessEvent) == 40, "Supplicant event size");
+static_assert(offsetof(SequoiaSupplicantSuccessEvent, status) == 8, "Supplicant status offset");
+static_assert(offsetof(SequoiaSupplicantSuccessEvent, transitionDisableFlags) == 12, "Supplicant flags offset");
+static_assert(offsetof(SequoiaSupplicantSuccessEvent, duringJoin) == 36, "Supplicant join offset");
 
